<Window x:Class="FleetTridi.Admin.AddTotemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar totem" Height="390" Width="430" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F6F5F8">
    <Border Margin="18" Background="White" CornerRadius="12" Padding="18">
        <StackPanel>
            <TextBlock Text="Cadastrar novo totem" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="O IP é usado apenas no bootstrap inicial por ADB. Depois o agente se conecta sozinho pela internet."
                       TextWrapping="Wrap" Foreground="#6F6B78" Margin="0,5,0,14"/>
            <TextBlock Text="Nome"/>
            <TextBox x:Name="NameBox" Padding="7" Margin="0,3,0,9"/>
            <TextBlock Text="Cidade"/>
            <TextBox x:Name="CityBox" Padding="7" Margin="0,3,0,9"/>
            <TextBlock Text="Local / ponto"/>
            <TextBox x:Name="SiteBox" Padding="7" Margin="0,3,0,9"/>
            <TextBlock Text="IP inicial"/>
            <TextBox x:Name="IpBox" Padding="7" Margin="0,3,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancel_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="Cadastrar" Click="Ok_Click" Padding="14,7"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>