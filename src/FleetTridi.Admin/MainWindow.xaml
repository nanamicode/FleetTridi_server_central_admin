<Window x:Class="FleetTridi.Admin.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FleetTridi Central" Height="760" Width="1180" Background="#F6F5F8">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="FleetTridi Central" FontSize="30" FontWeight="SemiBold"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,18">
<TextBox x:Name="ServerBox" Width="280" Text="http://localhost:8787" Margin="0,0,8,0"/>
<TextBox x:Name="UserBox" Width="130" Text="nanamicode" Margin="0,0,8,0"/>
<PasswordBox x:Name="PassBox" Width="130" Password="veralucia12" Margin="0,0,8,0"/>
<Button Content="Entrar / Atualizar" Click="Login_Click" Padding="16,8"/>
</StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DevicesGrid_SelectionChanged">
<DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding name}" Width="*"/><DataGridTextColumn Header="Cidade" Binding="{Binding city}" Width="120"/><DataGridTextColumn Header="Local" Binding="{Binding site}" Width="120"/><DataGridCheckBoxColumn Header="Online" Binding="{Binding online}" Width="70"/><DataGridTextColumn Header="IP" Binding="{Binding lastIp}" Width="130"/><DataGridTextColumn Header="Modelo" Binding="{Binding model}" Width="130"/></DataGrid.Columns>
</DataGrid>
<StackPanel Grid.Column="1" Margin="20,0,0,0">
<TextBlock Text="Totem selecionado" FontWeight="Bold" FontSize="17"/>
<TextBlock x:Name="SelectedLabel" Text="Nenhum" Margin="0,6,0,14"/>
<Button Content="HOME" Click="Home_Click" Margin="0,0,0,6" Padding="10"/><Button Content="BACK" Click="Back_Click" Margin="0,0,0,6" Padding="10"/>
<Button Content="Reiniciar Android" Click="Reboot_Click" Margin="0,0,0,6" Padding="10"/>
<TextBox x:Name="ShellBox" Text="id" Margin="0,12,0,6"/><Button Content="Executar shell root" Click="Shell_Click" Padding="10"/>
<Button Content="Instalar/Atualizar APK..." Click="InstallApk_Click" Margin="0,14,0,6" Padding="10"/>
<TextBox x:Name="TargetPathBox" Text="/sdcard/TridiAudience/creative.mp4" Margin="0,8,0,6"/><Button Content="Enviar arquivo..." Click="PushFile_Click" Padding="10"/>
<TextBlock Text="Saída" FontWeight="Bold" Margin="0,16,0,4"/><TextBox x:Name="OutputBox" Height="180" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
</StackPanel></Grid>
<TextBlock Grid.Row="3" x:Name="StatusText" Text="Desconectado" Margin="0,14,0,0"/>
</Grid></Window>