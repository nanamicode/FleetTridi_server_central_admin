<Window x:Class="FleetTridi.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FleetTridi Central" Height="860" Width="1440"
        MinHeight="720" MinWidth="1180" Background="#F6F5F8"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel>
                <TextBlock Text="FleetTridi Central" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Controle remoto dos totens TridiAudience" Foreground="#6F6B78" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="+ Adicionar totem" Click="AddTotem_Click" Padding="14,8" Margin="8,0,0,0"/>
                <Button Content="Bootstrap via ADB" Click="Bootstrap_Click" Padding="14,8" Margin="8,0,0,0"/>
                <Button Content="Excluir" Click="Delete_Click" Padding="14,8" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12" Margin="0,16,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Servidor" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ServerBox" Width="290" Text="http://localhost:8787" Margin="0,0,8,0" Padding="7"/>
                <TextBox x:Name="UserBox" Width="130" Text="nanamicode" Margin="0,0,8,0" Padding="7"/>
                <PasswordBox x:Name="PassBox" Width="145" Margin="0,0,8,0" Padding="7"/>
                <Button Content="Entrar / Atualizar" Click="Login_Click" Padding="16,8"/>
                <TextBlock x:Name="OnlineCount" Margin="18,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              SelectionChanged="DevicesGrid_SelectionChanged"
                              BorderThickness="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding name}" Width="*"/>
                            <DataGridTextColumn Header="Cidade" Binding="{Binding city}" Width="120"/>
                            <DataGridTextColumn Header="Local" Binding="{Binding site}" Width="120"/>
                            <DataGridCheckBoxColumn Header="Online" Binding="{Binding online}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Root" Binding="{Binding rootAvailable}" Width="55"/>
                            <DataGridTextColumn Header="IP atual" Binding="{Binding lastIp}" Width="125"/>
                            <DataGridTextColumn Header="Modelo" Binding="{Binding model}" Width="120"/>
                            <DataGridTextColumn Header="Audience" Binding="{Binding audienceVersion}" Width="95"/>
                            <DataGridTextColumn Header="Privilégio" Binding="{Binding privilegeMode}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="Ações em massa" FontWeight="Bold"/>
                        <WrapPanel Margin="0,7,0,0">
                            <Button Content="APK → selecionados" Click="BulkApkSelected_Click" Padding="10,6" Margin="0,0,6,6"/>
                            <Button Content="APK → todos online" Click="BulkApkOnline_Click" Padding="10,6" Margin="0,0,6,6"/>
                            <Button Content="Arquivo → selecionados" Click="BulkFileSelected_Click" Padding="10,6" Margin="0,0,6,6"/>
                            <Button Content="Arquivo → todos online" Click="BulkFileOnline_Click" Padding="10,6" Margin="0,0,6,6"/>
                            <Button Content="Reiniciar selecionados" Click="BulkReboot_Click" Padding="10,6" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="18,0,0,0">
                <StackPanel>
                    <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Totem selecionado" FontWeight="Bold" FontSize="17"/>
                            <TextBlock x:Name="SelectedLabel" Text="Nenhum" Margin="0,6,0,10" TextWrapping="Wrap"/>
                            <TextBox x:Name="TelemetryBox" IsReadOnly="True" Height="82" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#FAF9FB" BorderThickness="0" Padding="8"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Tela remota" FontWeight="Bold" FontSize="17"/>
                                <CheckBox x:Name="LiveCheck" DockPanel.Dock="Right" Content="Atualização contínua"
                                          Checked="LiveCheck_Changed" Unchecked="LiveCheck_Changed"/>
                            </DockPanel>
                            <Border Background="#111116" CornerRadius="8" Margin="0,10,0,8">
                                <Image x:Name="ScreenImage" Height="285" Stretch="Uniform" Focusable="True"
                                       MouseLeftButtonDown="ScreenImage_MouseLeftButtonDown"/>
                            </Border>
                            <WrapPanel>
                                <Button Content="Capturar" Click="Capture_Click" Padding="10,6" Margin="0,0,6,6"/>
                                <Button Content="HOME" Click="Home_Click" Padding="10,6" Margin="0,0,6,6"/>
                                <Button Content="BACK" Click="Back_Click" Padding="10,6" Margin="0,0,6,6"/>
                                <Button Content="Reiniciar Android" Click="Reboot_Click" Padding="10,6" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <TextBlock Text="Clique na imagem para tocar no totem. Com a imagem focada: setas, Enter, Esc e Home também são enviados." 
                                       Foreground="#6F6B78" TextWrapping="Wrap" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Manutenção do totem" FontWeight="Bold" FontSize="17"/>
                            <Button Content="Reiniciar TridiAudience" Click="RestartAudience_Click" Padding="10,7" Margin="0,10,0,0"/>
                            <Button Content="Instalar / atualizar APK..." Click="InstallApk_Click" Margin="0,10,0,6" Padding="10,7"/>
                            <TextBox x:Name="TargetPathBox" Text="/sdcard/TridiAudience/creative.mp4" Margin="0,6,0,6" Padding="7"/>
                            <Button Content="Enviar arquivo para caminho acima..." Click="PushFile_Click" Padding="10,7"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Releases do TridiAudience" FontWeight="Bold" FontSize="17"/>
                                <Button DockPanel.Dock="Right" Content="Atualizar lista" Click="RefreshReleases_Click" Padding="9,5"/>
                            </DockPanel>
                            <ComboBox x:Name="ReleaseBox" Margin="0,10,0,6" DisplayMemberPath="label"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ReleaseVersionBox" Grid.Column="0" Margin="0,0,4,6" Padding="7" Text="1.0.0"/>
                                <TextBox x:Name="ReleaseChannelBox" Grid.Column="1" Margin="4,0,0,6" Padding="7" Text="stable"/>
                            </Grid>
                            <Button Content="Cadastrar novo APK no catálogo..." Click="AddRelease_Click" Padding="10,7" Margin="0,0,0,8"/>
                            <TextBlock Text="Rollout por cidade (vazio = totens selecionados)" Foreground="#6F6B78" FontSize="11"/>
                            <Grid Margin="0,4,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RolloutCityBox" Grid.Column="0" Padding="7" Margin="0,0,4,0"/>
                                <TextBox x:Name="RolloutPercentBox" Grid.Column="1" Padding="7" Margin="4,0,0,0" Text="10"/>
                            </Grid>
                            <WrapPanel>
                                <Button Content="Simular rollout" Click="DryRunRelease_Click" Padding="10,7" Margin="0,0,6,0"/>
                                <Button Content="Publicar rollout" Click="DeployRelease_Click" Padding="10,7"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Saída / jobs" FontWeight="Bold" FontSize="17"/>
                            <TextBox x:Name="OutputBox" Height="170" Margin="0,8,0,0" TextWrapping="Wrap"
                                     AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Desconectado" Margin="0,13,0,0" Foreground="#6F6B78"/>
    </Grid>
</Window>